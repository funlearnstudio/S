{
  "Say": {"prefix":"say","body":["say ${1:\"Hello\"}"],"description":"Print a value"},
  "If": {"prefix":"if","body":["if ${1:condition}","    ${2:say \"yes\"}"]},
  "Function": {"prefix":"make","body":["make ${1:name} ${2:arg}","    ${3:give $2}"]},
  "Type": {"prefix":"type","body":["type ${1:Name}","    ${2:value = 0}","","    make ${3:method}","        ${4:say value}"]}
}
