use json
use text
use collections
use test

raw = "{\"name\":\"SE\",\"count\":2}"
data = json.parse raw
encoded = json.stringify data
say encoded

trimmed = text.trim "  SE  "
test.equal trimmed "SE"

parts = text.split "a,b,c" ","
test.equal parts.len 3
joined = text.join parts "-"
test.equal joined "a-b-c"

nums = [3, 1, 3, 2]
sorted = collections.sort nums
unique = collections.unique nums
test.equal sorted.len 4
test.equal unique.len 3
first = collections.first sorted
last = collections.last sorted
test.equal first 1
test.equal last 3

say "SE platform libraries OK"
