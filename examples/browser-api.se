# SE Web browser API + routing stress test
# No native JavaScript is needed for requests, navigation, JSON sending,
# retries, timeout handling, cancellation, DOM updates or form collection.

make NavButton label route
    html
        button ["type": "button"]
            text label

    css
        padding 10
        border_radius 8
        margin 4

        button:hover
            opacity 0.8

    js
        when click
            browser.go route

make Heading title subtitle
    html
        header
            h1 title
            p subtitle

    css
        padding 24

        h1
            font_size 36

make Output id text_value
    html
        pre ["id": id]
            text text_value

    css
        padding 16
        border_radius 10
        background "#f4f4f5"
        min_height 90

make LoadTodo
    html
        button ["type": "button"]
            text "GET JSON API"

    css
        padding 12
        border_radius 8

    js
        when click
            browser.text "#api-output" "Loading GET request..."
            try
                task = browser.get_json "https://jsonplaceholder.typicode.com/todos/1" ["timeout": 8000, "retries": 2, "key": "todo", "throw_http": true]
                result = async.await task
                pretty = browser.pretty result.data
                browser.text "#api-output" pretty
            else err
                browser.text "#api-output" err.message

make SendPost
    html
        button ["type": "button"]
            text "POST JSON"

    css
        padding 12
        border_radius 8

    js
        when click
            browser.text "#api-output" "Sending JSON..."
            payload = ["title": "Hello from SE", "body": "Sent by the SE browser runtime", "userId": 1]
            options = ["timeout": 8000, "retries": 1, "throw_http": true]
            try
                task = browser.post_json "https://jsonplaceholder.typicode.com/posts" payload options
                result = async.await task
                pretty = browser.pretty result.data
                browser.text "#api-output" pretty
            else err
                browser.text "#api-output" err.message

make TestError
    html
        button ["type": "button"]
            text "Test HTTP Error"

    css
        padding 12
        border_radius 8

    js
        when click
            browser.text "#api-output" "Requesting a missing resource..."
            try
                task = browser.get "https://jsonplaceholder.typicode.com/does-not-exist" ["timeout": 5000, "throw_http": true]
                result = async.await task
                browser.text "#api-output" result.text
            else err
                browser.text "#api-output" err.message

make StartSlowRequest
    html
        button ["type": "button"]
            text "Start slow request"

    css
        padding 12
        border_radius 8

    js
        when click
            browser.text "#api-output" "Slow request started. Press Cancel request before it finishes."
            try
                task = browser.get "https://httpbin.org/delay/10" ["timeout": 15000, "key": "slow-request", "dedupe": true, "throw_http": true]
                result = async.await task
                browser.text "#api-output" result.text
            else err
                browser.text "#api-output" err.message

make CancelRequest
    html
        button ["type": "button"]
            text "Cancel request"

    css
        padding 12
        border_radius 8

    js
        when click
            cancelled = browser.cancel "slow-request"
            if cancelled
                browser.text "#api-output" "Cancellation requested."
            else
                browser.text "#api-output" "No active request to cancel."

make MessageForm
    html
        form ["id": "message-form"]
            label "Name"
            input ["name": "name", "placeholder": "Your name"]
            label "Message"
            input ["name": "message", "placeholder": "Write a message"]

    css
        padding 20
        border_radius 12

        input
            padding 10
            margin 6

make SendForm
    html
        button ["type": "button"]
            text "Send form as JSON"

    css
        padding 12
        border_radius 8

    js
        when click
            data = browser.form_json "#message-form"
            options = ["timeout": 8000, "retries": 1, "throw_http": true]
            browser.text "#send-output" "Sending form..."
            try
                task = browser.post_json "https://httpbin.org/post" data options
                result = async.await task
                pretty = browser.pretty result.data
                browser.text "#send-output" pretty
            else err
                browser.text "#send-output" err.message

make ExternalLink
    html
        button ["type": "button"]
            text "Open external page"

    css
        padding 12
        border_radius 8

    js
        when click
            browser.open "https://example.com"

page "/"
    Heading "SE Web App" "Multi-page navigation, HTTP/HTTPS APIs and data sending from SE."
    NavButton "API tests" "/api"
    NavButton "Send data" "/send"
    NavButton "About" "/about"

page "/api"
    Heading "API tests" "GET, POST, HTTP errors, retries, timeouts and cancellation."
    NavButton "Home" "/"
    NavButton "Send data" "/send"
    LoadTodo
    SendPost
    TestError
    StartSlowRequest
    CancelRequest
    Output "api-output" "Ready."

page "/send"
    Heading "Send data" "Collect a browser form and send it as JSON."
    NavButton "Home" "/"
    NavButton "API tests" "/api"
    MessageForm
    SendForm
    Output "send-output" "Nothing sent yet."

page "/about"
    Heading "About this test" "Everything on these pages is authored in one SE source file."
    NavButton "Home" "/"
    ExternalLink
