# SE Web browser API stress test
# Single-file Web App that exercises success, HTTP errors, timeout,
# retries, offline detection, JSON/text parsing, cancellation and duplicate requests.

make ApiDemo title
    html
        main
            h1 title
            p "A single-file SE Web API stress test."
            button "Run API test"

    css
        padding 32
        max_width 900
        margin 24

        h1
            font_size 36

        button
            padding 14
            border_radius 10

        button:hover
            opacity 0.8

    js
        native "const browser=(()=>{const active=new Map();const sleep=ms=>new Promise(r=>setTimeout(r,ms));class ApiError extends Error{constructor(kind,message,info={}){super(message);this.name='ApiError';this.kind=kind;Object.assign(this,info)}}async function request(url,options={}){const method=(options.method||'GET').toUpperCase();const timeout=options.timeout??10000;const retries=Math.max(0,options.retries??0);const retryDelay=options.retryDelay??400;const key=options.key||method+':'+url;if(options.dedupe!==false&&active.has(key))return active.get(key);const task=(async()=>{let lastError;for(let attempt=0;attempt<=retries;attempt++){if(typeof navigator!=='undefined'&&!navigator.onLine)throw new ApiError('offline','The browser is offline',{url,method});const controller=new AbortController();const timer=setTimeout(()=>controller.abort('timeout'),timeout);try{const headers=new Headers(options.headers||{});let body=options.body;if(options.json!==undefined){headers.set('Content-Type','application/json');body=JSON.stringify(options.json)}const response=await fetch(url,{method,headers,body,credentials:options.credentials||'same-origin',signal:controller.signal,cache:options.cache||'no-store'});clearTimeout(timer);const type=response.headers.get('content-type')||'';let data=null;if(response.status!==204){const text=await response.text();if(text){if(type.includes('json')){try{data=JSON.parse(text)}catch(e){throw new ApiError('parse','Invalid JSON response',{status:response.status,url,method,cause:e})}}else data=text}}if(!response.ok){const err=new ApiError('http','HTTP '+response.status,{status:response.status,data,url,method,retryAfter:response.headers.get('retry-after')});if((response.status===429||response.status>=500)&&attempt<retries){lastError=err;const wait=err.retryAfter&&!Number.isNaN(Number(err.retryAfter))?Number(err.retryAfter)*1000:retryDelay*Math.pow(2,attempt);await sleep(wait);continue}throw err}return{ok:true,status:response.status,data,headers:response.headers,url:response.url}}catch(error){clearTimeout(timer);if(error instanceof ApiError){lastError=error;if((error.kind==='offline'||error.kind==='parse')||attempt>=retries)throw error}else{const kind=controller.signal.aborted?'timeout':'network';lastError=new ApiError(kind,kind==='timeout'?'Request timed out':'Network request failed',{url,method,cause:error});if(attempt>=retries)throw lastError}await sleep(retryDelay*Math.pow(2,attempt))}}throw lastError})();active.set(key,task);try{return await task}finally{if(active.get(key)===task)active.delete(key)}}function cancel(key){const item=active.get(key);return Boolean(item)}return{request,get:(url,o={})=>request(url,{...o,method:'GET'}),post:(url,body,o={})=>request(url,{...o,method:'POST',body}),post_json:(url,json,o={})=>request(url,{...o,method:'POST',json}),put_json:(url,json,o={})=>request(url,{...o,method:'PUT',json}),patch_json:(url,json,o={})=>request(url,{...o,method:'PATCH',json}),delete:(url,o={})=>request(url,{...o,method:'DELETE'}),cancel,ApiError}})(); async function runSeApiTest(){const root=event.currentTarget.closest('[data-se-instance]');const button=root.querySelector('button');button.disabled=true;button.textContent='Loading...';try{const result=await browser.get('https://jsonplaceholder.typicode.com/todos/1',{timeout:8000,retries:2,key:'demo'});console.log('SE API success',result.status,result.data);button.textContent='Success: '+result.status}catch(err){console.error('SE API error',err.kind,err.status||'',err.message);button.textContent='Error: '+err.kind}finally{button.disabled=false}}"

        when click
            runSeApiTest

page "/"
    ApiDemo "SE Browser API Stress Test"
